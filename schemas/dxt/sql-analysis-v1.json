{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sabino/dxt/blob/main/schemas/dxt/sql-analysis-v1.json",
  "title": "dxt SQL Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_type",
    "stats",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "dxt-sql-analysis-v1"
    },
    "adapter_type": {
      "enum": [
        "duckdb",
        "postgres"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parsed_nodes",
        "bound_nodes",
        "cache_hits",
        "invalidated_nodes",
        "elapsed_ms"
      ],
      "properties": {
        "parsed_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "bound_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "invalidated_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "column"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type",
        "nullable",
        "origins"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          },
          "uniqueItems": true
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "catalog",
        "schema",
        "identifier",
        "offset"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "offset",
        "line",
        "column",
        "coordinate_space"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "coordinate_space": {
          "const": "compiled_sql"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_id",
        "resource_type",
        "path",
        "status",
        "fingerprint",
        "columns",
        "inputs",
        "operators",
        "predicate_origins",
        "diagnostics",
        "plan",
        "compiled_sql"
      ],
      "properties": {
        "unique_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_type": {
          "enum": [
            "model",
            "analysis",
            "snapshot",
            "seed",
            "test"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "error"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "operators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operator"
          }
        },
        "predicate_origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          },
          "uniqueItems": true
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "plan": {
          "type": [
            "array",
            "object",
            "null"
          ]
        },
        "compiled_sql": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "fingerprint": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "diagnostics": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
